# ============================================================================
# Cybersecurity Intelligence Dashboard — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- Database ---------------------------------------------------------------
POSTGRES_USER=cybersec
POSTGRES_DB=cybersec_dashboard
# Use a long, random password. Example: openssl rand -base64 24
POSTGRES_PASSWORD=change_me_to_a_strong_password

# --- Backend security -------------------------------------------------------
# JWT signing key. Generate with: openssl rand -hex 32
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
# How long an access token stays valid (minutes). 480 = 8 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Comma-separated list of allowed CORS origins (your frontend URL[s]).
ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# --- Bootstrap super admin --------------------------------------------------
# Created automatically on the FIRST database initialization only.
# This account logs in and creates all other admin/analyst users.
# There are no demo/default credentials anywhere in the app.
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_EMAIL=admin@yourdomain.com
# Minimum 8 characters. Change immediately and store securely.
SUPER_ADMIN_PASSWORD=change_me_min_8_chars

# --- Frontend ---------------------------------------------------------------
# Path the browser uses to reach the API. Keep "/api" so requests go to nginx
# (same origin) which proxies them to the backend — no CORS, no exposed port.
# Only change this if you serve the API from a separate host/domain.
VITE_API_URL=/api
